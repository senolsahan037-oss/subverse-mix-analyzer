const fileInput = document.getElementById("audioFile");
const analysisMode = document.getElementById("analysisMode");
const modeSelect = document.getElementById("modeSelect");
const modeToggle = document.getElementById("modeToggle");
const modeMenu = document.getElementById("modeMenu");
const modeDisplay = document.getElementById("modeDisplay");
const analyzeBtn = document.getElementById("analyzeBtn");
const selectTrackBtn = document.getElementById("selectTrackBtn");
const selectedTrack = document.getElementById("selectedTrack");
const newAnalysisBtn = document.getElementById("newAnalysisBtn");
const uploadAnotherBtn = document.getElementById("uploadAnotherBtn");
const settingsBtn = document.getElementById("settingsBtn");
const uploadPanel = document.getElementById("uploadPanel");
const dropZone = document.getElementById("dropZone");
const statusBox = document.getElementById("status");
const statusMirror = document.getElementById("statusMirror");
const statusBadge = document.getElementById("statusBadge");
const reportSection = document.getElementById("report");
const trackName = document.getElementById("trackName");
const trackDuration = document.getElementById("trackDuration");
const trackSampleRate = document.getElementById("trackSampleRate");
const trackMode = document.getElementById("trackMode");
const scoreRing = document.getElementById("scoreRing");
const overallScore = document.getElementById("overallScore");
const topbarScore = document.getElementById("topbarScore");
const qualityBadge = document.getElementById("qualityBadge");
const utilityStrip = document.getElementById("utilityStrip");
const qualityTierText = document.getElementById("qualityTierText");
const qualityStars = document.getElementById("qualityStars");
const technicalVerdict = document.getElementById("technicalVerdict");
const overviewIndicators = document.getElementById("overviewIndicators");
const tonalSummary = document.getElementById("tonalSummary");
const summaryCards = document.getElementById("summaryCards");
const warningsList = document.getElementById("warningsList");
const frequencyBands = document.getElementById("frequencyBands");
const stereoViz = document.getElementById("stereoViz");
const stereoScoreText = document.getElementById("stereoScoreText");
const phaseScope = document.getElementById("phaseScope");
const dynamicsViz = document.getElementById("dynamicsViz");
const dynamicsScoreText = document.getElementById("dynamicsScoreText");
const tonalHeatmap = document.getElementById("tonalHeatmap");
const transientGraph = document.getElementById("transientGraph");
const loudnessMovement = document.getElementById("loudnessMovement");
const frequencyDensity = document.getElementById("frequencyDensity");
const clippingHistory = document.getElementById("clippingHistory");
const spectralActivity = document.getElementById("spectralActivity");
const resultBox = document.getElementById("result");
const tooltipPanel = document.getElementById("tooltipPanel");
const tooltipTitle = document.getElementById("tooltipTitle");
const tooltipBody = document.getElementById("tooltipBody");
const tooltipSuggest = document.getElementById("tooltipSuggest");
const assistantDock = document.getElementById("assistantDock");
const assistantMood = document.getElementById("assistantMood");
const assistantLine = document.getElementById("assistantLine");
const assistantMetrics = document.getElementById("assistantMetrics");

let assistantBaseState = {
  mood: "Nobette",
  quality: "average",
  expression: "neutral",
  line: "Dosya gelince konusurum.",
};

const API_URL = "http://127.0.0.1:8000/analyze";
const SCORE_WEIGHTS = {
  peakSafety: 0.14,
  loudnessBalance: 0.12,
  crestFactor: 0.1,
  stereoUsage: 0.1,
  frequencyBalance: 0.16,
  harshness: 0.1,
  mud: 0.1,
  monoCompatibility: 0.08,
  dynamicRange: 0.1,
};

function clamp(value, min, max) {
  return Math.min(max, Math.max(min, value));
}

function formatMetric(value, suffix = "") {
  if (value === null || value === undefined || Number.isNaN(Number(value))) return "N/A";
  return `${Number(value).toFixed(2)}${suffix}`;
}

function getFrequencyBalance(data) {
  return data.frequency_balance || data.frequency_bands || {};
}

function getQualityClass(score) {
  if (score >= 88) return "excellent";
  if (score >= 72) return "good";
  if (score >= 52) return "average";
  if (score >= 30) return "weak";
  return "critical";
}

function getQualityTier(score) {
  if (score < 20) return "Poor";
  if (score < 40) return "Weak";
  if (score < 60) return "Decent";
  if (score < 75) return "Good";
  if (score < 88) return "High Quality";
  return "Professional / Release Ready";
}

function getStarString(score) {
  const filled = clamp(Math.round(score / 20), 0, 5);
  return "★".repeat(filled) + "☆".repeat(5 - filled);
}

function setTooltipContent(target, title, body, suggest) {
  target.dataset.tooltipTitle = title;
  target.dataset.tooltipBody = body;
  target.dataset.tooltipSuggest = suggest;
}

function setStatus(text) {
  statusBox.textContent = text;
  if (statusMirror) statusMirror.textContent = text;
  if (statusBadge) statusBadge.textContent = text;
}

function setMode(mode) {
  analysisMode.value = mode;
  modeDisplay.textContent = mode;
  modeMenu.querySelectorAll(".mode-option").forEach((option) => {
    option.classList.toggle("is-active", option.dataset.mode === mode);
  });
}

function closeModeMenu() {
  modeMenu.hidden = true;
  modeToggle.setAttribute("aria-expanded", "false");
}

function toggleModeMenu() {
  const nextHidden = !modeMenu.hidden;
  modeMenu.hidden = nextHidden;
  modeToggle.setAttribute("aria-expanded", String(!nextHidden));
}

function setUploadCondensed(condensed) {
  uploadPanel.classList.toggle("is-collapsed", condensed);
}

function setSelectedFile(file) {
  if (!file) return;
  const transfer = new DataTransfer();
  transfer.items.add(file);
  fileInput.files = transfer.files;
  selectedTrack.textContent = file.name;
}

function computePeakSafetyScore(peakDbfs) {
  if (!Number.isFinite(peakDbfs)) return 0;
  if (peakDbfs > -0.1) return 5;
  if (peakDbfs > -0.5) return 18;
  if (peakDbfs > -1.0) return 34;
  if (peakDbfs > -2.0) return 60;
  if (peakDbfs > -3.0) return 76;
  if (peakDbfs > -6.0) return 84;
  return 78;
}

function computeLoudnessBalanceScore(lufs, mode) {
  if (!Number.isFinite(lufs)) return 0;
  if (mode === "pre_master") {
    if (lufs < -24) return 42;
    if (lufs < -20) return 60;
    if (lufs <= -14) return 86;
    if (lufs <= -11) return 68;
    if (lufs <= -9) return 38;
    return 18;
  }
  if (lufs < -16) return 50;
  if (lufs < -14) return 68;
  if (lufs <= -9) return 88;
  if (lufs <= -8) return 62;
  if (lufs <= -7) return 34;
  return 14;
}

function computeCrestFactorScore(crest) {
  if (!Number.isFinite(crest)) return 0;
  if (crest < 4) return 8;
  if (crest < 6) return 24;
  if (crest < 8) return 50;
  if (crest < 10) return 74;
  if (crest <= 14) return 88;
  if (crest <= 18) return 76;
  return 62;
}

function computeStereoUsageScore(stereo, channels) {
  if (channels < 2 || stereo === null || !Number.isFinite(stereo)) return 70;
  if (stereo < -0.15) return 6;
  if (stereo < 0) return 16;
  if (stereo < 0.15) return 42;
  if (stereo < 0.3) return 64;
  if (stereo <= 0.92) return 84;
  if (stereo <= 0.98) return 72;
  return 58;
}

function computeFrequencyBalanceScore(bands) {
  const ranges = {
    sub: [0.03, 0.14],
    bass: [0.08, 0.22],
    low_mid: [0.1, 0.2],
    mid: [0.16, 0.36],
    high_mid: [0.14, 0.28],
    high: [0.06, 0.2],
  };
  let penalty = 0;
  for (const [band, [min, max]] of Object.entries(ranges)) {
    const value = Number(bands[band] ?? 0);
    if (value < min) penalty += ((min - value) / min) * 14;
    else if (value > max) penalty += ((value - max) / max) * 14;
  }
  return Math.round(clamp(100 - penalty, 0, 100));
}

function computeHarshnessScore(bands) {
  const high = Number(bands.high ?? 0);
  const highMid = Number(bands.high_mid ?? 0);
  const combined = high + highMid;
  if (high > 0.34 || combined > 0.56) return 14;
  if (high > 0.28 || combined > 0.48) return 34;
  if (high > 0.22 || combined > 0.42) return 56;
  if (combined < 0.16) return 52;
  return 84;
}

function computeMudScore(bands) {
  const lowMid = Number(bands.low_mid ?? 0);
  const bass = Number(bands.bass ?? 0);
  if (lowMid > 0.3) return 12;
  if (lowMid > 0.24) return 28;
  if (lowMid > 0.2) return 52;
  if (lowMid < 0.06 && bass < 0.08) return 46;
  return 84;
}

function computeMonoCompatibilityScore(stereo) {
  if (stereo === null || !Number.isFinite(stereo)) return 78;
  if (stereo < -0.15) return 4;
  if (stereo < 0) return 14;
  if (stereo < 0.15) return 38;
  if (stereo < 0.25) return 58;
  return 86;
}

function computeDynamicRangeScore(crest, lufs, mode) {
  if (!Number.isFinite(crest) || !Number.isFinite(lufs)) return 0;
  let score = computeCrestFactorScore(crest);
  if (mode === "final_master" && lufs > -8 && crest < 8) score -= 18;
  if (mode === "pre_master" && lufs > -12 && crest < 9) score -= 12;
  return Math.round(clamp(score, 0, 100));
}

function classifyWarningSeverity(text) {
  const normalized = text.toLowerCase();
  if (normalized.includes("clip") || normalized.includes("phase") || normalized.includes("negative")) return "critical";
  if (normalized.includes("dark") || normalized.includes("thin") || normalized.includes("harsh") || normalized.includes("mud") || normalized.includes("low")) return "caution";
  return "info";
}

function severityIcon(level) {
  if (level === "critical") return "▲";
  if (level === "caution") return "■";
  return "●";
}

function buildTechnicalVerdict(data, overallScore) {
  const bands = getFrequencyBalance(data);
  const peakDbfs = Number(data.peak_dbfs);
  const crest = Number(data.crest_factor_db);
  const stereo = data.stereo_correlation === null ? null : Number(data.stereo_correlation);

  const verdict = [];
  if (peakDbfs > -1) verdict.push("Peak margin is too tight.");
  else if ((bands.low_mid ?? 0) > 0.22) verdict.push("Low-mid density suggests mud.");
  else if ((bands.high ?? 0) > 0.28) verdict.push("Top end is leaning harsh.");
  else if ((bands.high_mid ?? 0) + (bands.high ?? 0) < 0.16) verdict.push("Dark tonal balance.");
  else verdict.push("Frequency balance is broadly controlled.");

  if (stereo !== null && stereo < 0) verdict.push("Mono compatibility is compromised.");
  else if (crest < 6) verdict.push("Dynamics are heavily constrained.");
  else verdict.push(overallScore < 50 ? "Multiple technical weaknesses are evident." : "Core metrics remain technically serviceable.");

  return verdict.slice(0, 2).join(" ");
}

function evaluateQuality(data, mode) {
  const bands = getFrequencyBalance(data);
  const peakDbfs = Number(data.peak_dbfs);
  const lufs = Number(data.approximate_lufs);
  const crest = Number(data.crest_factor_db);
  const stereo = data.stereo_correlation === null ? null : Number(data.stereo_correlation);
  const channels = Number(data.channels ?? 1);

  const categoryScores = {
    peakSafety: computePeakSafetyScore(peakDbfs),
    loudnessBalance: computeLoudnessBalanceScore(lufs, mode),
    crestFactor: computeCrestFactorScore(crest),
    dynamicRange: computeDynamicRangeScore(crest, lufs, mode),
    stereoUsage: computeStereoUsageScore(stereo, channels),
    monoCompatibility: computeMonoCompatibilityScore(stereo),
    frequencyBalance: computeFrequencyBalanceScore(bands),
    harshness: computeHarshnessScore(bands),
    mud: computeMudScore(bands),
    transientDensity: Math.round(clamp((computeCrestFactorScore(crest) * 0.7) + (computeDynamicRangeScore(crest, lufs, mode) * 0.3), 0, 100)),
  };

  let overallScore = Math.round(
    Object.entries(categoryScores)
      .filter(([key]) => key in SCORE_WEIGHTS)
      .reduce((sum, [key, value]) => sum + value * SCORE_WEIGHTS[key], 0),
  );

  if (peakDbfs > -0.5) overallScore -= 12;
  else if (peakDbfs > -1) overallScore -= 6;
  if ((bands.high ?? 0) > 0.3) overallScore -= 8;
  if ((bands.low_mid ?? 0) > 0.24) overallScore -= 8;
  if (stereo !== null && stereo < 0) overallScore -= 18;
  if (lufs > -8 && crest < 7) overallScore -= 10;

  overallScore = Math.round(clamp(overallScore, 0, 100));
  return {
    categoryScores,
    overallScore,
    qualityTier: getQualityTier(overallScore),
    qualityClass: getQualityClass(overallScore),
    shortVerdict: buildTechnicalVerdict(data, overallScore),
  };
}

function getMetricCards(data, evaluation, mode) {
  return [
    { key: "lufs", label: "LUFS", value: formatMetric(data.approximate_lufs), score: computeLoudnessBalanceScore(Number(data.approximate_lufs), mode) },
    { key: "peak", label: "Peak", value: formatMetric(data.peak_dbfs, " dBFS"), score: computePeakSafetyScore(Number(data.peak_dbfs)) },
    { key: "rms", label: "RMS", value: formatMetric(data.rms_dbfs, " dBFS"), score: clamp(100 - Math.abs(Number(data.rms_dbfs) + 12) * 8, 10, 90) },
    { key: "crest", label: "Crest", value: formatMetric(data.crest_factor_db, " dB"), score: computeCrestFactorScore(Number(data.crest_factor_db)) },
    { key: "range", label: "Dyn Range", value: `${evaluation.categoryScores.dynamicRange}/100`, score: evaluation.categoryScores.dynamicRange },
    { key: "stereo", label: "Stereo", value: `${evaluation.categoryScores.stereoUsage}/100`, score: evaluation.categoryScores.stereoUsage },
    { key: "mono", label: "Mono", value: `${evaluation.categoryScores.monoCompatibility}/100`, score: evaluation.categoryScores.monoCompatibility },
    { key: "transient", label: "Transient", value: `${evaluation.categoryScores.transientDensity}/100`, score: evaluation.categoryScores.transientDensity },
  ];
}

function getTooltipCopy(key, data, evaluation) {
  const map = {
    lufs: ["LUFS", `Current loudness is ${formatMetric(data.approximate_lufs)} LUFS.`, "More limiting may increase loudness but reduce dynamics."],
    peak: ["Peak", `Peak is ${formatMetric(data.peak_dbfs, " dBFS")} from full scale.`, "0 dBFS proximity may cause clipping after encoding."],
    rms: ["RMS", `RMS is ${formatMetric(data.rms_dbfs, " dBFS")} and reflects average signal energy.`, "Higher RMS without control often raises fatigue and reduces headroom."],
    crest: ["Crest Factor", `Crest factor is ${formatMetric(data.crest_factor_db, " dB")}.`, "Lower crest factor generally means stronger compression or limiting."],
    range: ["Dynamic Range", `Dynamic range score is ${evaluation.categoryScores.dynamicRange}/100.`, "Preserve movement before increasing loudness."],
    stereo: ["Stereo Usage", `Stereo score is ${evaluation.categoryScores.stereoUsage}/100.`, "Wide stereo is useful only if phase remains stable."],
    mono: ["Mono Compatibility", `Mono compatibility score is ${evaluation.categoryScores.monoCompatibility}/100.`, "Reduce phase-heavy width if fold-down becomes unstable."],
    transient: ["Transient Density", `Transient density score is ${evaluation.categoryScores.transientDensity}/100.`, "Preserve attack if the mix feels flattened."],
  };
  return map[key];
}

function renderHeaderMeta(fileName, data, mode, evaluation) {
  trackName.textContent = fileName || "Audio file";
  trackDuration.textContent = data.duration_seconds ? `${data.duration_seconds.toFixed(2)}s` : "N/A";
  trackSampleRate.textContent = data.sample_rate ? `${data.sample_rate} Hz` : "N/A";
  trackMode.textContent = mode;
  topbarScore.textContent = `${evaluation.overallScore}/100`;
}

function getAssistantState(data, evaluation) {
  const bands = getFrequencyBalance(data);
  const peak = Number(data.peak_dbfs);
  const lufs = Number(data.approximate_lufs);
  const crest = Number(data.crest_factor_db);
  const stereo = data.stereo_correlation === null ? null : Number(data.stereo_correlation);
  const lowEnd = Number(bands.sub ?? 0) + Number(bands.bass ?? 0);
  const topEnd = Number(bands.high_mid ?? 0) + Number(bands.high ?? 0);

  if (peak > -0.5 && crest < 6) {
    return {
      mood: "Mesai",
      quality: "critical",
      expression: "concerned",
      line: "Limiter burada mesaiye kalmis.",
    };
  }
  if ((bands.low_mid ?? 0) > 0.24 && lowEnd > 0.22) {
    return {
      mood: "Yogun",
      quality: "weak",
      expression: "skeptical",
      line: "Kick ile bass ayni apartmanda kavga ediyor.",
    };
  }
  if ((bands.sub ?? 0) > 0.14) {
    return {
      mood: "Subda",
      quality: "weak",
      expression: "skeptical",
      line: "Bu kadar sub basinca kick tasinmayi dusunuyor.",
    };
  }
  if (evaluation.overallScore < 45) {
    return {
      mood: "Sert",
      quality: "weak",
      expression: "skeptical",
      line: "Low-mid tarafinda trafik var.",
    };
  }
  if (evaluation.overallScore < 65) {
    return {
      mood: "Temkinli",
      quality: "average",
      expression: (bands.high_mid ?? 0) + (bands.high ?? 0) < 0.16 ? "skeptical" : "neutral",
      line: stereo !== null && stereo < 0.2
        ? "Stereo alan nefes almak istiyor."
        : "Biraz alan acilirsa kendine gelir.",
    };
  }
  if (evaluation.overallScore < 82) {
    return {
      mood: "Memnun",
      quality: "good",
      expression: "approving",
      line: crest >= 8
        ? "Transientleri oldurmemis olman guzel."
        : "Low-end kontrolu saglam.",
    };
  }
  if (evaluation.overallScore >= 82) {
    return {
      mood: "Onayli",
      quality: "excellent",
      expression: "calm",
      line: peak <= -1 && lufs <= -9 && topEnd < 0.42
        ? "Tamam... burada biri ne yaptigini biliyor."
        : "Limiter fazla calismamis. Saygi duydum.",
    };
  }

  return {
    mood: "Nobette",
    quality: "average",
    expression: "neutral",
    line: "Biraz daha alan acilirsa toparlayabilir.",
  };
}

function renderAssistant(data, evaluation) {
  const state = getAssistantState(data, evaluation);
  assistantBaseState = state;
  assistantDock.dataset.quality = state.quality;
  assistantDock.dataset.expression = state.expression;
  assistantMood.textContent = state.mood;
  assistantLine.textContent = state.line;
  assistantMetrics.innerHTML = [
    ["Peak", `${evaluation.categoryScores.peakSafety}/100`, getQualityClass(evaluation.categoryScores.peakSafety)],
    ["Stereo", `${evaluation.categoryScores.stereoUsage}/100`, getQualityClass(evaluation.categoryScores.stereoUsage)],
    ["Tone", `${evaluation.categoryScores.frequencyBalance}/100`, getQualityClass(evaluation.categoryScores.frequencyBalance)],
  ].map(([label, value, quality]) => `
    <span class="assistant-metric quality-${quality}">
      <span class="assistant-metric-label">${label}</span>
      <strong class="assistant-metric-value">${value}</strong>
    </span>
  `).join("");
}

function setAssistantState(state) {
  assistantBaseState = state;
  assistantDock.dataset.quality = state.quality;
  assistantDock.dataset.expression = state.expression || "neutral";
  assistantMood.textContent = state.mood;
  assistantLine.textContent = state.line;
}

function getAssistantHoverComment(title, body, suggest) {
  const normalized = title.toLowerCase();
  if (normalized.includes("lufs")) return "Ses yukselir, ama dinamigi rehin vermemek lazim.";
  if (normalized.includes("peak")) return "0 dBFS'ye fazla yaklasinca codec'ler huysuzlasir.";
  if (normalized.includes("stereo")) return "Stereo guzel ama merkez biraz yalniz kalmis olabilir.";
  if (normalized.includes("phase")) return "Faz guvendeyse genislik daha rahat nefes alir.";
  if (normalized.includes("low-mid") || normalized.includes("tonal") || normalized.includes("density")) return "Low-mid tarafinda trafik varsa herkes ayni kapiya cikiyor demektir.";
  if (normalized.includes("transient") || normalized.includes("dynamics")) return "Transientleri oldurmeden yuksek ses almak zaten isin ince tarafi.";
  if (normalized.includes("high")) return "Ust taraf eksikse mix kucuk hoparlorde biraz erken yorulur.";
  if (normalized.includes("warning")) return "Bu notlari kulakla dogrula; sadece sayiya bakip karar verilmez.";
  return suggest || body || assistantBaseState.line;
}

function setAssistantHoverState(target) {
  if (!target?.dataset.tooltipTitle) {
    assistantDock.dataset.quality = assistantBaseState.quality;
    assistantDock.dataset.expression = assistantBaseState.expression || "neutral";
    assistantMood.textContent = assistantBaseState.mood;
    assistantLine.textContent = assistantBaseState.line;
    return;
  }
  const normalized = target.dataset.tooltipTitle.toLowerCase();
  assistantDock.dataset.expression =
    normalized.includes("peak") || normalized.includes("warning")
      ? "concerned"
      : normalized.includes("stereo") || normalized.includes("phase")
        ? "focused"
        : normalized.includes("high") || normalized.includes("tonal")
          ? "skeptical"
          : "listening";
  assistantMood.textContent = "Dinliyor";
  assistantLine.textContent = getAssistantHoverComment(
    target.dataset.tooltipTitle,
    target.dataset.tooltipBody || "",
    target.dataset.tooltipSuggest || "",
  );
}

function renderOverview(data, evaluation) {
  const hueMap = { critical: 2, weak: 22, average: 42, good: 112, excellent: 182 };
  scoreRing.style.setProperty("--score-angle", `${Math.round((evaluation.overallScore / 100) * 360)}deg`);
  scoreRing.style.setProperty("--score-hue", hueMap[evaluation.qualityClass]);
  scoreRing.dataset.quality = evaluation.qualityClass;
  overallScore.textContent = String(evaluation.overallScore);
  qualityBadge.textContent = `Quality: ${evaluation.qualityTier}`;
  qualityBadge.dataset.quality = evaluation.qualityClass;
  qualityTierText.textContent = evaluation.qualityTier;
  qualityStars.textContent = getStarString(evaluation.overallScore);
  technicalVerdict.textContent = evaluation.shortVerdict;
  setTooltipContent(scoreRing, "Overall Score", `Weighted technical evaluation across loudness, dynamics, stereo, and tonal balance. Current score: ${evaluation.overallScore}/100.`, "Resolve severe peak, phase, or tonal penalties before chasing loudness.");

  const indicatorDefs = [
    ["Peak Safe", evaluation.categoryScores.peakSafety, "Peak safety estimates clipping and codec overs risk.", "Leave more margin if peak safety is weak."],
    ["Tonal", evaluation.categoryScores.frequencyBalance, "Tonal score reflects balance across low, mid, and high zones.", "Correct mud, darkness, or harshness before raising loudness."],
    ["Mono", evaluation.categoryScores.monoCompatibility, "Mono score tracks likely fold-down stability.", "Reduce phase-heavy widening if mono score is weak."],
    ["Harsh", evaluation.categoryScores.harshness, "Harshness score reflects high and high-mid control.", "Reduce excess upper band energy if playback feels sharp."],
  ];
  overviewIndicators.innerHTML = indicatorDefs.map(([label, value, body, suggest]) => `
    <div class="indicator-chip quality-${getQualityClass(value)}" data-tooltip-title="${label}" data-tooltip-body="${body} Current score: ${value}/100." data-tooltip-suggest="${suggest}">
      <div class="indicator-chip-top">
        <span class="indicator-chip-label">${label}</span>
        <strong class="indicator-chip-value">${value}/100</strong>
      </div>
      <div class="indicator-chip-strip">
        ${Array.from({ length: 12 }, (_, index) => `<span class="indicator-chip-seg ${index < Math.max(1, Math.round(value / 8.34)) ? "is-active" : ""}"></span>`).join("")}
      </div>
      <div class="indicator-chip-pulse">
        ${Array.from({ length: 8 }, (_, index) => `<span class="indicator-chip-dot ${index < Math.max(1, Math.round(value / 12.5)) ? "is-active" : ""}"></span>`).join("")}
      </div>
    </div>
  `).join("");

  const warnings = (data.basic_warnings || data.warnings || []).slice(0, 4);
  warningsList.innerHTML = "";
  if (!warnings.length) {
    warningsList.innerHTML = `<li class="warning-item severity-info" data-tooltip-title="Warnings" data-tooltip-body="No critical or cautionary issues were flagged by the current heuristic rules." data-tooltip-suggest="Manual listening checks are still required for final decisions."><span class="warning-icon">●</span><span class="warning-text">No warnings flagged.</span></li>`;
  } else {
    warnings.forEach((warning) => {
      const severity = classifyWarningSeverity(warning);
      const item = document.createElement("li");
      item.className = `warning-item severity-${severity}`;
      item.innerHTML = `<span class="warning-icon">${severityIcon(severity)}</span><span class="warning-text">${warning}</span>`;
      setTooltipContent(item, `Warning: ${severity}`, warning, severity === "critical" ? "Resolve this before evaluating polish or loudness." : "Confirm by listening and rebalance only if the issue persists across systems.");
      warningsList.appendChild(item);
    });
  }

  const bands = getFrequencyBalance(data);
  const tonalItems = [
    ["Low End", Math.round((Number(bands.sub ?? 0) + Number(bands.bass ?? 0)) * 100), "Combined sub and bass share."],
    ["Low-Mid", Math.round(Number(bands.low_mid ?? 0) * 100), "Low-mid density drives warmth or mud."],
    ["Top End", Math.round((Number(bands.high_mid ?? 0) + Number(bands.high ?? 0)) * 100), "Top end controls bite and air."],
  ];
  tonalSummary.innerHTML = tonalItems.map(([label, value, note]) => `
    <div class="summary-chip quality-${getQualityClass(Math.min(100, value * 2))}" data-tooltip-title="${label}" data-tooltip-body="${note} Current level: ${value}%." data-tooltip-suggest="Judge this zone on speakers and headphones before making broad EQ moves.">
      <div class="summary-chip-head">
        <span class="summary-chip-label">${label}</span>
        <strong class="summary-chip-value">${value}%</strong>
      </div>
      <div class="summary-chip-bar">
        <span class="summary-chip-fill" style="width:${Math.max(10, value)}%"></span>
      </div>
      <div class="summary-chip-heat">
        ${Array.from({ length: 10 }, (_, index) => `<span class="summary-chip-cell ${index < Math.max(1, Math.round(value / 10)) ? "is-active" : ""}"></span>`).join("")}
      </div>
    </div>
  `).join("");
}

function renderMetrics(data, evaluation, mode) {
  summaryCards.innerHTML = "";
  getMetricCards(data, evaluation, mode).forEach((metric) => {
    const quality = getQualityClass(metric.score);
    const card = document.createElement("article");
    card.className = `metric-card quality-${quality}`;
    const meter = Array.from({ length: 12 }, (_, index) => `<span class="mini-bar ${index < Math.round(metric.score / 8.34) ? "is-active" : ""}"></span>`).join("");
    card.innerHTML = `
      <span class="metric-label">${metric.label}</span>
      <strong class="metric-value">${metric.value}</strong>
      <div class="metric-mini-strip">${meter}</div>
      <span class="metric-state">${quality}</span>
    `;
    const [title, body, suggest] = getTooltipCopy(metric.key, data, evaluation);
    setTooltipContent(card, title, body, suggest);
    summaryCards.appendChild(card);
  });
}

function getBandSuggestion(name, value) {
  if (name === "high" && value < 0.06) return "High frequencies are weak. Mix may sound dark on smaller speakers.";
  if (name === "high" && value > 0.2) return "Top end is elevated. Check for brittle playback on bright systems.";
  if (name === "low_mid" && value > 0.2) return "Low-mid energy is elevated. Reduce buildup if translation feels cloudy.";
  if (name === "sub" && value < 0.03) return "Sub content is light. Low-end weight may feel reduced on full-range systems.";
  return "Current balance is within the expected zone for this band.";
}

function renderFrequencyBands(data) {
  const bands = getFrequencyBalance(data);
  const order = ["sub", "bass", "low_mid", "mid", "high_mid", "high"];
  const bodies = {
    sub: "Sub energy drives weight and rumble control.",
    bass: "Bass energy affects punch and low-end foundation.",
    low_mid: "Low-mid buildup often reads as mud or boxiness.",
    mid: "Midrange controls intelligibility and forwardness.",
    high_mid: "High-mid energy affects bite and presence.",
    high: "High band controls air, sheen, and edge.",
  };
  frequencyBands.innerHTML = `
    <div class="freq-grid-lines"></div>
    ${order.map((name) => {
      const value = Number(bands[name] ?? 0);
      const percent = clamp(value * 100, 0, 100);
      return `
        <div class="freq-bin quality-${getQualityClass(computeFrequencyBalanceScore(bands))}" data-tooltip-title="${name.replace("_", " ")}" data-tooltip-body="${bodies[name]} Current share: ${percent.toFixed(1)}%." data-tooltip-suggest="${getBandSuggestion(name, value)}">
          <span class="freq-fill" style="height:${Math.max(percent, 8)}%"></span>
          <span class="freq-heat"></span>
          <span class="freq-label">${name.replace("_", " ")}</span>
        </div>
      `;
    }).join("")}
  `;
}

function renderStereoVisualization(data, evaluation) {
  const stereo = data.stereo_correlation === null ? null : Number(data.stereo_correlation);
  const width = stereo === null ? 28 : clamp((1 - Math.abs(stereo)) * 100, 8, 100);
  const center = stereo === null ? 50 : clamp(((stereo + 1) / 2) * 100, 0, 100);
  const stereoQuality = getQualityClass(evaluation.categoryScores.stereoUsage);
  stereoScoreText.textContent = `${evaluation.categoryScores.stereoUsage}/100`;
  stereoViz.innerHTML = `
    <div class="stereo-meter quality-${stereoQuality}">
      <div class="phase-leds">
        ${Array.from({ length: 12 }, (_, index) => `<span class="phase-led ${index < Math.max(1, Math.round(evaluation.categoryScores.stereoUsage / 8.34)) ? "is-active" : ""}"></span>`).join("")}
      </div>
      <div class="stereo-line"></div>
      <div class="stereo-spread" style="width:${width}%; left:${center}%"></div>
      <div class="stereo-center-mark"></div>
    </div>
    <div class="stereo-footer">
      <div class="stereo-phase-strip quality-${getQualityClass(evaluation.categoryScores.monoCompatibility)}">
        <span class="stereo-phase-fill" style="width:${clamp(evaluation.categoryScores.monoCompatibility, 4, 100)}%"></span>
      </div>
      <div class="stereo-readout">${stereo === null ? "Mono" : stereo.toFixed(2)}</div>
    </div>
  `;
  setTooltipContent(stereoViz, "Stereo Field", stereo === null ? "Mono signal path detected. Width is intentionally minimal." : `Stereo image is ${width.toFixed(0)}% wide with correlation ${stereo.toFixed(2)}.`, stereo !== null && stereo < 0 ? "Stereo spread is unsafe. Reduce phase-dependent widening." : "Stereo image is wide but phase-safe.");

  phaseScope.innerHTML = Array.from({ length: 49 }, (_, index) => {
    const active = Math.abs((index % 7) - 3) <= Math.max(0, Math.round(width / 32));
    return `<span class="scope-dot ${active ? "is-active" : ""}"></span>`;
  }).join("");
  setTooltipContent(phaseScope, "Phase Scope", `Phase scope density reflects likely side activity. Mono score: ${evaluation.categoryScores.monoCompatibility}/100.`, "Reduce decorrelated width if the phase cloud spreads too far.");
}

function renderDynamicsVisualization(data, evaluation, mode) {
  const crest = Number(data.crest_factor_db);
  const lufs = Number(data.approximate_lufs);
  const density = clamp(1 - ((crest - 4) / 12), 0.08, 0.94);
  const loudnessPosition = clamp((Math.abs(lufs) - 6) / 18, 0.05, 1);
  const dynamicQuality = getQualityClass(evaluation.categoryScores.dynamicRange);
  dynamicsScoreText.textContent = `${evaluation.categoryScores.dynamicRange}/100`;
  dynamicsViz.innerHTML = `
    <div class="dynamics-strip quality-${dynamicQuality}">
      ${Array.from({ length: 18 }, (_, index) => {
        const shape = Math.sin((index / 18) * Math.PI * 2) * 0.22 + 0.58;
        const level = clamp(shape + (1 - density) * 0.18, 0.14, 1);
        return `<span class="dyn-bar" style="height:${(level * 100).toFixed(1)}%"></span>`;
      }).join("")}
    </div>
    <div class="transient-trace quality-${dynamicQuality}">
      ${Array.from({ length: 16 }, (_, index) => `<span class="trace-node ${index < Math.max(1, Math.round(evaluation.categoryScores.transientDensity / 6.25)) ? "is-active" : ""}"></span>`).join("")}
    </div>
    <div class="loudness-strip quality-${getQualityClass(computeLoudnessBalanceScore(lufs, mode))}">
      <span class="loudness-fill" style="width:${(loudnessPosition * 100).toFixed(1)}%"></span>
    </div>
  `;
  setTooltipContent(dynamicsViz, "Dynamics", `Transient density is ${Math.round(density * 100)}%. Loudness reads ${formatMetric(lufs)} LUFS.`, "Current loudness is moderate. More limiting may increase loudness but reduce dynamics.");
}

function renderTonalHeatmap(data) {
  const bands = getFrequencyBalance(data);
  const order = ["sub", "bass", "low_mid", "mid", "high_mid", "high"];
  tonalHeatmap.innerHTML = order.map((name) => {
    const value = Number(bands[name] ?? 0);
    return `<div class="heat-cell quality-${getQualityClass(Math.round(value * 400))}" style="--heat:${clamp(value * 100, 8, 100)}%" data-tooltip-title="${name.replace("_", " ")} heat" data-tooltip-body="Relative energy in this zone is ${Math.round(value * 100)}%." data-tooltip-suggest="${getBandSuggestion(name, value)}"><span>${name.replace("_", " ")}</span></div>`;
  }).join("");
}

function renderBottomStrip(data, evaluation, mode) {
  const crest = Number(data.crest_factor_db);
  const lufs = Number(data.approximate_lufs);
  const bands = getFrequencyBalance(data);
  transientGraph.innerHTML = Array.from({ length: 32 }, (_, index) => {
    const level = clamp((Math.sin((index / 32) * Math.PI * 3.2) * 0.22) + 0.56 + ((crest - 8) * 0.015), 0.14, 1);
    return `<span class="micro-bar ${index < Math.round(evaluation.categoryScores.transientDensity / 3.2) ? "is-active" : ""}" style="height:${(level * 100).toFixed(1)}%"></span>`;
  }).join("");
  setTooltipContent(transientGraph, "Transient Graph", `Transient activity is mapped from crest factor and dynamic range. Current score: ${evaluation.categoryScores.transientDensity}/100.`, "If this graph collapses while loudness rises, transient clarity is being lost.");

  loudnessMovement.innerHTML = Array.from({ length: 28 }, (_, index) => {
    const level = clamp((Math.cos((index / 28) * Math.PI * 2.1) * 0.16) + 0.5 + ((18 - Math.abs(lufs)) * 0.01), 0.16, 1);
    return `<span class="micro-bar is-active" style="height:${(level * 100).toFixed(1)}%"></span>`;
  }).join("");
  setTooltipContent(loudnessMovement, "Loudness Movement", `Estimated loudness contour around ${formatMetric(lufs)} LUFS.`, "Higher loudness without headroom usually compresses movement.");

  const order = ["sub", "bass", "low_mid", "mid", "high_mid", "high"];
  frequencyDensity.innerHTML = order.map((name) => {
    const value = Number(bands[name] ?? 0);
    return `<span class="density-cell quality-${getQualityClass(Math.round(value * 400))}" style="flex:${Math.max(1, Math.round(value * 100))}" data-tooltip-title="${name.replace("_", " ")} density" data-tooltip-body="Relative density in ${name.replace("_", " ")} is ${Math.round(value * 100)}%." data-tooltip-suggest="${getBandSuggestion(name, value)}"></span>`;
  }).join("");

  const peak = Number(data.peak_dbfs);
  clippingHistory.innerHTML = Array.from({ length: 18 }, (_, index) => {
    const risk = peak > -1 ? index > 11 : peak > -2 ? index > 14 : false;
    return `<span class="clip-step ${risk ? "is-critical" : "is-safe"}"></span>`;
  }).join("");
  setTooltipContent(clippingHistory, "Clipping History", `Peak safety score is ${evaluation.categoryScores.peakSafety}/100.`, "Repeated red markers imply minimal margin before codec overs or clipping.");

  spectralActivity.innerHTML = Array.from({ length: 30 }, (_, index) => {
    const zone = order[index % order.length];
    const value = Number(bands[zone] ?? 0);
    const active = value > 0.08;
    return `<span class="activity-cell ${active ? "is-active" : ""} quality-${getQualityClass(Math.round(value * 400))}"></span>`;
  }).join("");
  setTooltipContent(spectralActivity, "Spectral Activity", "This strip summarizes zone activity density across the band map.", "Look for persistent top-end excess or missing low-end density before mastering moves.");
}

function renderReport(data, fileName, mode) {
  const evaluation = evaluateQuality(data, mode);
  renderHeaderMeta(fileName, data, mode, evaluation);
  renderOverview(data, evaluation);
  renderMetrics(data, evaluation, mode);
  renderFrequencyBands(data);
  renderStereoVisualization(data, evaluation);
  renderDynamicsVisualization(data, evaluation, mode);
  renderTonalHeatmap(data);
  renderBottomStrip(data, evaluation, mode);
  renderAssistant(data, evaluation);
  resultBox.textContent = JSON.stringify(data, null, 2);
  reportSection.hidden = false;
  setUploadCondensed(true);
}

function resetForNewAnalysis() {
  setUploadCondensed(false);
  setStatus("Ready for new analysis.");
  setAssistantState({
    mood: "Nobette",
    quality: "average",
    expression: "neutral",
    line: "Yeni dosyayi ac, kulaklari tekrar masaya koyalim.",
  });
  requestAnimationFrame(() => {
    dropZone.scrollIntoView({ behavior: "smooth", block: "nearest" });
  });
}

async function runAnalysis() {
  const file = fileInput.files[0];
  if (!file) {
    setStatus("Select an audio file first.");
    return false;
  }
  const formData = new FormData();
  formData.append("file", file);
  const mode = analysisMode.value;
  setStatus("Analyzing...");
  if (!reportSection.hidden) {
    setAssistantState({
      mood: "Dinlemede",
      quality: "average",
      expression: "listening",
      line: "Bir tur dinliyorum. Peak, stereo ve tonal denge birazdan masada.",
    });
  }
  analyzeBtn.disabled = true;

  try {
    const response = await fetch(API_URL, { method: "POST", body: formData });
    if (!response.ok) throw new Error(`HTTP ${response.status}`);
    const data = await response.json();
    renderReport(data, file.name, mode);
    setStatus("Analysis complete.");
    return true;
  } catch (error) {
    reportSection.hidden = false;
    resultBox.textContent = String(error);
    setStatus("Analysis failed.");
    setUploadCondensed(false);
    setAssistantState({
      mood: "Kesildi",
      quality: "weak",
      expression: "concerned",
      line: "Bu sefer veri masaya dusmedi. Dosyayi bir daha deneyelim.",
    });
    return false;
  } finally {
    analyzeBtn.disabled = false;
  }
}

function showTooltip(target, clientX, clientY) {
  if (!target?.dataset.tooltipTitle) return;
  tooltipTitle.textContent = target.dataset.tooltipTitle;
  tooltipBody.textContent = target.dataset.tooltipBody || "";
  tooltipSuggest.textContent = target.dataset.tooltipSuggest || "";
  tooltipPanel.hidden = false;
  requestAnimationFrame(() => {
    const rect = tooltipPanel.getBoundingClientRect();
    const padding = 14;
    const left = Math.min(window.innerWidth - rect.width - padding, clientX + 14);
    const top = Math.min(window.innerHeight - rect.height - padding, clientY + 14);
    tooltipPanel.style.left = `${Math.max(padding, left)}px`;
    tooltipPanel.style.top = `${Math.max(padding, top)}px`;
  });
}

function hideTooltip() {
  tooltipPanel.hidden = true;
}

analyzeBtn.addEventListener("click", runAnalysis);

newAnalysisBtn.addEventListener("click", () => {
  resetForNewAnalysis();
});

uploadAnotherBtn.addEventListener("click", () => {
  resetForNewAnalysis();
  requestAnimationFrame(() => fileInput.click());
});

settingsBtn.addEventListener("click", () => {
  setStatus("Settings are not implemented in this MVP.");
});

selectTrackBtn.addEventListener("click", () => {
  fileInput.click();
});

modeToggle.addEventListener("click", (event) => {
  event.stopPropagation();
  toggleModeMenu();
});

modeMenu.querySelectorAll(".mode-option").forEach((option) => {
  option.addEventListener("click", () => {
    setMode(option.dataset.mode);
    closeModeMenu();
  });
});

dropZone.addEventListener("click", (event) => {
  if (
    event.target.closest(".tool-btn") ||
    event.target.closest(".mode-menu") ||
    event.target.closest(".selected-track")
  ) {
    return;
  }
  fileInput.click();
});

dropZone.addEventListener("keydown", (event) => {
  if (event.key === "Enter" || event.key === " ") {
    event.preventDefault();
    fileInput.click();
  }
});

["dragenter", "dragover"].forEach((eventName) => {
  dropZone.addEventListener(eventName, (event) => {
    event.preventDefault();
    dropZone.classList.add("is-dragging");
  });
});

["dragleave", "drop"].forEach((eventName) => {
  dropZone.addEventListener(eventName, (event) => {
    event.preventDefault();
    if (eventName === "drop" && event.dataTransfer?.files?.length) {
      const [file] = event.dataTransfer.files;
      setSelectedFile(file);
      setStatus(`Selected: ${file.name}`);
    }
    dropZone.classList.remove("is-dragging");
  });
});

fileInput.addEventListener("change", () => {
  if (fileInput.files[0]) {
    selectedTrack.textContent = fileInput.files[0].name;
    setStatus(`Selected: ${fileInput.files[0].name}`);
  }
});

document.addEventListener("pointermove", (event) => {
  const target = event.target.closest("[data-tooltip-title]");
  if (!target) {
    hideTooltip();
    setAssistantHoverState(null);
    return;
  }
  showTooltip(target, event.clientX, event.clientY);
  setAssistantHoverState(target);
});

document.addEventListener("pointerleave", () => {
  hideTooltip();
  setAssistantHoverState(null);
});

document.addEventListener("click", (event) => {
  if (!modeSelect.contains(event.target)) {
    closeModeMenu();
  }
});

setMode(analysisMode.value);
