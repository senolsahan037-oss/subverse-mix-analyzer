function markNodeNotranslate(node) {
  if (!node) return;
  node.setAttribute("translate", "no");
  node.classList.add("notranslate");
}

function markNodeTranslatable(node) {
  if (!node) return;
  node.setAttribute("translate", "yes");
  node.classList.remove("notranslate");
}

function applyTranslationProtection(root = document) {
  [
    document.body,
    appRoot,
    heroShell,
    reportSection,
    tooltipPanel,
    assistantMetrics,
  ].forEach(markNodeNotranslate);

  root.querySelectorAll(TRANSLATION_LOCK_SELECTORS).forEach(markNodeNotranslate);
  markNodeTranslatable(assistantLine);
}

function clamp(value, min, max) {
  return Math.min(max, Math.max(min, value));
}

function formatMetric(value, suffix = "") {
  if (value === null || value === undefined || Number.isNaN(Number(value))) return "N/A";
  return `${Number(value).toFixed(2)}${suffix}`;
}

function safeNumber(value, fallback = 0) {
  const numeric = Number(value);
  return Number.isFinite(numeric) ? numeric : fallback;
}

function normalizeUiText(value) {
  if (value === null || value === undefined) return UI_TEXT_FALLBACK;
  if (typeof value !== "string") return String(value);

  const trimmed = value.trim();
  if (!trimmed) return UI_TEXT_FALLBACK;
  if (LEGACY_UI_TRANSLATIONS.has(trimmed)) return LEGACY_UI_TRANSLATIONS.get(trimmed);

  let normalized = trimmed;
  LEGACY_UI_REPLACEMENTS.forEach(([pattern, replacement]) => {
    normalized = normalized.replace(pattern, replacement);
  });

  const hasTurkishChars = /[ÇĞİÖŞÜçğıöşü]/.test(normalized);
  const hasKnownTurkishWords = /\b(burada|fazla|guzel|saygi|biraz|alan|trafik|nefes|kulak|dosya|denge|dinliyor|dinlemede|yogun|subda|nobette|onayli|memnun|temkinli|sert|mesai|kesildi)\b/i.test(normalized);

  if (hasTurkishChars || hasKnownTurkishWords) {
    console.warn("Language consistency fallback applied.", { original: value });
    return UI_TEXT_FALLBACK;
  }

  return normalized;
}

function setSafeText(node, value) {
  node.textContent = normalizeUiText(value);
}

function escapeHtml(value) {
  return String(value)
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll("\"", "&quot;")
    .replaceAll("'", "&#39;");
}

function getAssistantParagraphs(section) {
  if (Array.isArray(section?.paragraphs) && section.paragraphs.length) {
    return section.paragraphs
      .map((paragraph) => normalizeUiText(paragraph))
      .filter(Boolean);
  }

  return normalizeUiText(section?.body || UI_TEXT_FALLBACK)
    .split(/\n{2,}/)
    .map((paragraph) => paragraph.trim())
    .filter(Boolean);
}

function createAssistantParagraphNode(paragraph) {
  const paragraphNode = document.createElement("p");
  paragraphNode.className = "assistant-paragraph";

  const markerNode = document.createElement("span");
  markerNode.className = "assistant-paragraph-marker";
  markerNode.setAttribute("aria-hidden", "true");
  markerNode.textContent = "›";

  const textNode = document.createElement("span");
  textNode.className = "assistant-paragraph-text";
  textNode.textContent = paragraph;

  paragraphNode.appendChild(markerNode);
  paragraphNode.appendChild(textNode);
  return paragraphNode;
}

function createStudioNoteNode(noteText) {
  const noteNode = document.createElement("section");
  noteNode.className = "assistant-studio-note";

  const labelNode = document.createElement("div");
  labelNode.className = "assistant-studio-note-label";
  labelNode.textContent = "Studio Note";

  const dividerNode = document.createElement("div");
  dividerNode.className = "assistant-studio-note-divider";
  dividerNode.setAttribute("aria-hidden", "true");

  noteNode.appendChild(labelNode);
  noteNode.appendChild(dividerNode);
  noteNode.appendChild(createAssistantParagraphNode(noteText));

  return noteNode;
}

function renderAssistantSections(sections) {
  if (!assistantLine) return;
  assistantLine.replaceChildren();

  const safeSections = Array.isArray(sections) && sections.length
    ? sections
    : [{ id: "note", body: UI_TEXT_FALLBACK }];

  const fragment = document.createDocumentFragment();

  safeSections.forEach((section) => {
    const sectionNode = document.createElement("section");
    sectionNode.className = "assistant-section";
    sectionNode.dataset.section = section.id || "note";

    getAssistantParagraphs(section).forEach((paragraph) => {
      const studioNoteMatch = paragraph.match(/^(.*?)(?:\s+)?Studio Note:\s*(.+)$/s);

      if (studioNoteMatch) {
        const leadingText = studioNoteMatch[1].trim();
        const studioNoteText = studioNoteMatch[2].trim();

        if (leadingText) {
          sectionNode.appendChild(createAssistantParagraphNode(leadingText));
        }
        if (studioNoteText) {
          sectionNode.appendChild(createStudioNoteNode(studioNoteText));
        }
        return;
      }

      sectionNode.appendChild(createAssistantParagraphNode(paragraph));
    });

    fragment.appendChild(sectionNode);
  });

  assistantLine.appendChild(fragment);
}

function applyLanguageConsistencyCheck() {
  [
    statusBox,
    statusMirror,
    statusBadge,
    qualityBadge,
    qualityTierText,
    technicalVerdict,
    assistantMood,
  ].filter(Boolean).forEach((node) => {
    node.textContent = normalizeUiText(node.textContent);
  });

  if (assistantBaseState?.sections && assistantLine) {
    renderAssistantSections(assistantBaseState.sections);
  }
}

function getFrequencyBalance(data) {
  return data.frequency_balance || data.frequency_bands || {};
}

function getSpectrumBandData() {
  const selectedName = fileInput.files[0]?.name || "";
  if (currentAnalysisData && currentAnalyzedTrackName && currentAnalyzedTrackName === selectedName) {
    return currentAnalysisData;
  }
  return currentAnalysisData && !selectedName ? currentAnalysisData : {};
}

function isTrackMapAnalysisReady() {
  const selectedName = fileInput.files[0]?.name || "";
  if (!trackMapAnalysisActive || !currentAnalysisData) return false;
  if (!selectedName) return Boolean(currentAnalyzedTrackName);
  return currentAnalyzedTrackName === selectedName;
}

function getQualityClass(score) {
  if (score >= 88) return "excellent";
  if (score >= 72) return "good";
  if (score >= 52) return "average";
  if (score >= 30) return "weak";
  return "critical";
}

function getQualityTier(score) {
  if (score < 20) return "Poor";
  if (score < 40) return "Weak";
  if (score < 60) return "Decent";
  if (score < 75) return "Good";
  if (score < 88) return "High Quality";
  return "Professional / Release Ready";
}

function getStarString(score) {
  const filled = clamp(Math.round(score / 20), 0, 5);
  return "★".repeat(filled) + "☆".repeat(5 - filled);
}

function setTooltipContent(target, title, body, suggest) {
  target.dataset.tooltipTitle = normalizeUiText(title);
  target.dataset.tooltipBody = normalizeUiText(body);
  target.dataset.tooltipSuggest = normalizeUiText(suggest);
}

function setStatus(text) {
  const safeText = normalizeUiText(text);
